APP_NAME=projeto_pessoal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (PostgreSQL em container Docker)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=projeto_pessoal
DB_USERNAME=projeto_pessoal
DB_PASSWORD=secret

# Credenciais consumidas pelo container postgres (docker-compose)
POSTGRES_DB=projeto_pessoal
POSTGRES_USER=projeto_pessoal
POSTGRES_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `database`: o módulo WhatsApp usa jobs em fila (containers queue/scheduler).
QUEUE_CONNECTION=database
CACHE_STORE=database

# Leitura de comprovantes por IA (Anthropic Claude com visão)
ANTHROPIC_API_KEY=
ANTHROPIC_RECEIPT_MODEL=claude-sonnet-4-6

# ===== Módulo WhatsApp (Evolution API + IA) =====
# Cliente Laravel -> Evolution, pela rede interna do compose.
EVOLUTION_BASE_URL=http://evolution:8080
# Chave global da Evolution. Manter IGUAL à AUTHENTICATION_API_KEY abaixo.
EVOLUTION_API_KEY=troque-esta-chave
# Consumidas pelo CONTAINER evolution via env_file (mesmo padrão do POSTGRES_*):
AUTHENTICATION_API_KEY=troque-esta-chave
# Banco próprio da Evolution no mesmo postgres. Manter usuário/senha em
# sincronia com POSTGRES_USER/POSTGRES_PASSWORD.
DATABASE_CONNECTION_URI=postgresql://projeto_pessoal:secret@postgres:5432/evolution?schema=public

# URL que a Evolution chama para entregar mensagens (rede interna do compose).
WHATSAPP_WEBHOOK_URL=http://backend:8000/api/whatsapp/webhook/evolution
# Token exigido na query string do webhook; requests sem ele recebem 403.
WHATSAPP_WEBHOOK_TOKEN=troque-este-token

# IA do módulo WhatsApp (relatórios e análises de conversas)
ANTHROPIC_WHATSAPP_MODEL=claude-sonnet-5
# Horários dos relatórios automáticos (no timezone abaixo)
WHATSAPP_RELATORIO_HORA=19:00
WHATSAPP_RESUMO_HORA=07:30
WHATSAPP_TIMEZONE=America/Sao_Paulo

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Autenticacao JWT (tymon/jwt-auth) — gere com: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60

# Usuario administrador inicial (criado pela migration de seed).
# A senha precisa ter no minimo 12 caracteres.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Garmin Connect (modulo Saude). O Laravel fala com o sidecar Python do
# docker-compose (servico `garmin`), que guarda os tokens em um volume.
# GARMIN_SIDECAR_TOKEN e um segredo qualquer compartilhado entre os dois.
# GARMIN_TOKENS_BASE64 semeia o token store na primeira subida em producao:
#   base64 -i ~/.garminconnect/garmin_tokens.json
# Sem ele, faca o login uma vez com:
#   docker compose run --rm -it garmin python auth_cli.py
GARMIN_ATIVO=false
GARMIN_SIDECAR_URL=http://garmin:8000
GARMIN_SIDECAR_TOKEN=
GARMIN_USER_EMAIL=
GARMIN_DIAS_JANELA=7
GARMIN_TOKENS_BASE64=
