# Modelo do .env de PRODUÇÃO. Copiar para backend/laravel/.env no servidor e
# preencher. NUNCA versionar o arquivo preenchido (.gitignore já cobre).
#
# COMO EDITAR ESTE ARQUIVO EM PRODUÇÃO: nunca com `sed -i`, nem com editor que
# salve criando arquivo novo. Ele é um bind mount de arquivo único e o Docker o
# amarra ao inode — trocar o inode faz o container continuar lendo o conteúdo
# ANTIGO, silenciosamente. Use um método que preserve o inode:
#     tmp=$(mktemp); <edite para $tmp>; cat "$tmp" > .env; rm -f "$tmp"
# Ou rode ./deploy/deploy.sh depois de editar, que ele recria os containers.
#
# ATENÇÃO À APP_KEY: nenhum campo do banco é cifrado com ela hoje (as senhas
# são bcrypt), mas ela assina os payloads de sessão e de cache. Gere uma vez,
# guarde no gerenciador de senhas e evite trocar — trocar derruba todas as
# sessões ativas.

APP_NAME="Sistema Raiz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sistemaraiz.movidoaweb.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# O serviço postgres do docker-compose.prod.yml lê POSTGRES_* deste mesmo
# arquivo, por isso os dois conjuntos precisam bater. Os nomes são idênticos
# aos do ambiente local de propósito: o dump restaurado traz os objetos com
# esse owner.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=projeto_pessoal
DB_USERNAME=projeto_pessoal
DB_PASSWORD=

POSTGRES_DB=projeto_pessoal
POSTGRES_USER=projeto_pessoal
POSTGRES_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# O acesso é só por HTTPS.
SESSION_SECURE_COOKIE=true

# `database`: o módulo WhatsApp usa jobs em fila; o compose de produção tem os
# serviços `queue` (worker) e `scheduler` (relatórios agendados).
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@sistemaraiz.movidoaweb.com.br"
# Literal, e não "${APP_NAME}": o serviço postgres do compose lê este mesmo
# arquivo via env_file e tentaria interpolar a variável.
MAIL_FROM_NAME="Sistema Raiz"

JWT_SECRET=
JWT_TTL=60

# Leitura de comprovantes por IA (App\Services\ReceiptAI).
ANTHROPIC_API_KEY=
ANTHROPIC_RECEIPT_MODEL=claude-sonnet-4-6

# ===== Módulo WhatsApp (Evolution API + IA) =====
# Cliente Laravel -> Evolution, pela rede interna do compose.
EVOLUTION_BASE_URL=http://evolution:8080
# Chave global da Evolution. Gerar um valor forte (ex.: openssl rand -hex 32)
# e manter IGUAL à AUTHENTICATION_API_KEY abaixo.
EVOLUTION_API_KEY=
# Consumidas pelo CONTAINER evolution via env_file (mesmo padrão do POSTGRES_*):
AUTHENTICATION_API_KEY=
# Banco próprio da Evolution no mesmo postgres (o deploy.sh garante que ele
# existe). Usuário/senha em sincronia com POSTGRES_USER/POSTGRES_PASSWORD.
DATABASE_CONNECTION_URI=postgresql://projeto_pessoal:SENHA_DO_POSTGRES@postgres:5432/evolution?schema=public

# URL interna que a Evolution chama para entregar mensagens (nginx do container
# `backend`, porta 80).
WHATSAPP_WEBHOOK_URL=http://backend/api/whatsapp/webhook/evolution
# Token exigido na query string do webhook; requests sem ele recebem 403.
# A rota é alcançável pelo proxy público do Next, então use um valor forte.
WHATSAPP_WEBHOOK_TOKEN=

# IA do módulo WhatsApp (relatórios e análises de conversas)
ANTHROPIC_WHATSAPP_MODEL=claude-sonnet-5
# Horários dos relatórios automáticos (no timezone abaixo)
WHATSAPP_RELATORIO_HORA=19:00
WHATSAPP_RESUMO_HORA=07:30
WHATSAPP_TIMEZONE=America/Sao_Paulo

# Usuário administrador inicial. Lido pela migration
# 2026_03_11_200523_seed_default_admin_user, que faz upsert por e-mail.
# Se qualquer um dos três ficar vazio, a migration não cria ninguém — e o
# sistema sobe sem nenhum usuário, impossibilitando o login.
# ADMIN_PASSWORD exige no mínimo 12 caracteres.
# Como o banco de produção nasce de um dump que já contém o admin e já tem essa
# migration registrada, ela não roda de novo; preencher aqui é só rede de
# segurança. Depois que o usuário existir, apague ADMIN_PASSWORD daqui: ela não
# é mais necessária e o .env vai para o backup diário.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
